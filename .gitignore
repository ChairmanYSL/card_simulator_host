# POS kernel parameter configs.
# Supported in-repo library: cases/<brand>/pos_configs/ (git-tracked; holds
# CAPK moduli -- Amex Expresspay test keys).  The legacy single-file fallback
# below stays ignored so a stray copy is never committed by accident.
cases/*/kernel_params.json

# editor / os
.idea/
.vscode/
.DS_Store
Thumbs.db

# vendor reference XMLs (Expresspay 4.2.0)  local-only, contain CAPK moduli
# (key material); never committed.  See docs/protocol-change-notice-v1.2.md
refernce/
