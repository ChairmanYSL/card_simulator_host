  "preconditions": [
    "phone NFC enabled and card simulator app in foreground",
    "POS terminal configured with CONF_01 + PROFILE_01 (the reference log's TERM is byte-identical to GPO-PROC71-XP2's)",
    "the FCI PDOL is reconstructed: the reference log's 9F38 has 9 masked bytes (FFFFFFFFFFFFFFFF01) where the kernel's own emvdol_packet trace reads 9F5B(6) 9F5C(1) 9F5D(1) — the reconstruction makes the 52 entries total exactly the 100 bytes of the logged GPO data and splits that data with zero leftover",
    "the reference log masks tag 5A/57 to all Fs, so a real AMEX PAN + track 2 are constructed (same approach as GPO-PROC71-XP2)",
    "AIP 0880 carries no SDA/DDA bit: this case exercises GPO data handling only (no offline data authentication)"
  ],
  "test_plan": [
    {
      "step": 1,
      "action": "host pushes the card profile (AID A000000025010403, 52-entry PDOL, AIP 0880, AFL 08010100) and starts emulation",
      "expect": "android reports emulating"
    },
    {
      "step": 2,
      "action": "operator completes the 15.00 EUR transaction",
      "expect": "POS sends GET PROCESSING OPTIONS with 100 bytes of PDOL data, then reads SFI 1 record 1 and sends GENERATE AC (TC)"
    },
    {
      "step": 3,
      "action": "host judges the GPO data tag by tag against the 52-entry PDOL: known tags carry terminal values, unsupported tags are zero filled",
      "expect": "card.gpo.pdol.9F6E=18000003, 9F35=22, 9F02=000000001500, 9F03=000000000000, 9F34=000000, and an unsupported tag such as 9F79 is all zeroes"
    },
    {
      "step": 4,
      "action": "host asserts the GPO response and the outcome",
      "expect": "card.gpo.aip=0880, card.gpo.afl=08010100, offline approved (outcome=approved, online=offline, resp_code=00)"
    }
  ],
  "timeout_seconds": 180,
  "retry_on_fail": 0,
