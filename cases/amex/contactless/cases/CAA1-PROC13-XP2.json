  "preconditions": [
    "phone NFC enabled and card simulator app in foreground",
    "POS loaded with CONF_01 + PROFILE_02 (the log's TERM: 9F33=200888 → terminal CDA support, 9F6E=9C800003, 9F35=22)",
    "card AIP=0980: byte 1 bit 1 = CDA supported, bit 5 = cardholder verification supported; the kernel starts ODA with 'Term and Card all support CDA' (AIP_CDA_SUPPORT && 9F33[2]&0x08)",
    "the profile carries the ICC private key (cda-icc-caa1, pushed in keys.rsa_keys) plus the 9F46/9F47/9F48 certificate material, so the card can sign the 9F4B Signed Dynamic Application Data",
    "the CA public key index 01 of this CONFIG is the locally generated test CA key of this case (the 8F of the profile names it); the per-case CONFIG clears and re-provisions the CAPK table (EmvService.applyCaseConfig), so index 01 is the test key for this run",
    "the reference log masks the PAN (5A=FFFFFFFFFFFFFFFF); the profile uses a Luhn-valid test PAN with the log's issuer identifier 37341234 and PAN sequence 00 (log 5F34=00), everything else is the log's data",
    "why the log aborted: in that (pre-V4.2.3) kernel build the CDA auth value tag collided with 9F4B, so the GENERATE AC response was re-parsed with a corrupted 9F4B -> 'GAC resp doesnt contain 9F27 or 9F36 or 9F26' -> analyze_gac_resp 111 -> END(111); V4.2.3 stores it under 0xBC (emv_tag.h:534) and parse_gac_resp accepts the 77 template",
    "the pass criteria require out.datarecord.9F4C: it is only stored after the CDA hash check, so it proves verification instead of relying on the 102+TC -> APPROVED mapping",
    "this case's card answers TC (acBehavior=offline_approved): the offline approval path"
  ],
  "test_plan": [
    {
      "step": 1,
      "action": "host pushes the card profile (AIP 0980, CDA certs) with CONF_01 + PROFILE_02 and starts emulation",
      "expect": "android reports emulating"
    },
    {
      "step": 2,
      "action": "operator completes the 15.00 EUR transaction",
      "expect": "the kernel reads the three records, recovers the issuer and ICC public keys (retrieve_capk/issuer/icc = 0) and requests CDA in the first GENERATE AC (P1=0x50)"
    },
    {
      "step": 3,
      "action": "host judges the GENERATE AC response of the card",
      "expect": "9F4B (SDAD, length = ICC modulus) is present"
    },
    {
      "step": 4,
      "action": "host judges the POS out payload",
      "expect": "outcome=approved / online=offline / resp_code=00 (offline approved TC) and out.datarecord.9F4C present (the kernel stored the ICC Dynamic Number, i.e. the CDA hash matched)"
    }
  ],
  "timeout_seconds": 180,
  "retry_on_fail": 0,
  "expected_results": [
    {
      "path": "outcome",
      "op": "eq",
      "expect": "approved"
