venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# node
node_modules/
frontend/dist/
*.tsbuildinfo

# runtime data
runs/
logs/
*.log
.lock

# scratch area (probe scripts, test scratch dirs, reference snapshots);
