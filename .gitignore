tmp/

# local-only POS kernel parameter sets (AID/CAPK/TERM).
# Generated from the POS assets by tools/export_kernel_params.py; contains CAPK
# moduli (key material) and must never be committed.
cases/*/kernel_params.json

# editor / os
.idea/
.vscode/
.DS_Store
Thumbs.db

# vendor reference XMLs (Expresspay 4.2.0)  local-only, contain CAPK moduli
# (key material); never committed.  See docs/protocol-change-notice-v1.2.md
refernce/
